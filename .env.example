# air-web-console — copy to `.env.local` (git-ignored) to preset the console.
#
# This BFF is now the trust boundary: every base URL and API key below is
# read server-side only and never shipped to the browser (see
# `GET /api/config`, which returns base URLs — not secret, needed for
# "state the destination" — but reduces every key to a `*_keyed: boolean`).
# The sidebar can only *select* a declared target by name; it has no
# editable URL/key fields. Add or change an environment here and restart
# the server — that's the whole point: the server only ever calls hosts it
# configured itself.

# ── Gateway auth (browser → this BFF) ─────────────────────────────────────
# The "independent web client authenticates to its API gateway" leg of the
# integration this console simulates. Both variables below must hold the
# SAME value — one is read server-side to check incoming calls, the other
# is baked into the browser bundle at build time so the app can send it.
#
# This is NOT a secret in the sense the upstream air-* API keys are: it is
# a publishable client identifier (the same role a Stripe publishable key
# plays), whose job is gating this gateway's front door and demonstrating
# the auth step — not protecting an upstream credential. Anyone with this
# app's own bundle already has it. Change it per deployment mainly to keep
# casual/anonymous internet traffic from driving your BFF, not to hide it
# from your own users.
AIR_WEB__GATEWAY_TOKEN=air-web-console-dev-gateway-token
NEXT_PUBLIC_AIR_WEB_GATEWAY_TOKEN=air-web-console-dev-gateway-token

# ── Which target is selected at start-up ──────────────────────────────────
# Must name one of the targets below. `local` always exists. An unknown name
# falls back to `local` rather than connecting somewhere unintended.

AIR_WEB__TARGET=local

# ── local ───────────────────────────────────────────────────────────────
# Pre-wired to the AIR port map (air-infra/README.md): 8081 air-orchestrator-service,
# 8082 air-classifier-service, 8083 air-llm. Every value below is already the
# built-in default, so this block only needs editing if your local ports
# differ.

AIR_WEB__TARGETS__LOCAL__LABEL=Local — services on this machine
AIR_WEB__TARGETS__LOCAL__CLASSIFIER_BASE_URL=http://127.0.0.1:8082
# The development key air-classifier-service's own .env.example ships, valid only
# against that repo's development hash salt — a default rather than an auth
# bypass, so a local run exercises the same authenticated path as QA.
AIR_WEB__TARGETS__LOCAL__CLASSIFIER_API_KEY=airc_local_dev_key
AIR_WEB__TARGETS__LOCAL__ORCHESTRATOR_BASE_URL=http://127.0.0.1:8081
# air-orchestrator-service runs two channels behind one pipeline, and the channel comes
# from the KEY, not a header — the customer key on /v1/query is a 403, and
# so is the business key on /v1/chat. Both are needed to exercise the whole
# service.
AIR_WEB__TARGETS__LOCAL__ORCHESTRATOR_CUSTOMER_API_KEY=airp_local_customer_key
AIR_WEB__TARGETS__LOCAL__ORCHESTRATOR_BUSINESS_API_KEY=airp_local_business_key
AIR_WEB__TARGETS__LOCAL__LLM_BASE_URL=http://127.0.0.1:8083
# air-llm's own .env.example provisions this exact token for a caller
# identity named "air-client-dev" — that literal string is fixed by
# air-llm's local config, not a naming choice made here. Keep it as-is so a
# local air-llm checkout authenticates with no edits on its side.
AIR_WEB__TARGETS__LOCAL__LLM_API_KEY=air-client-dev
# Optional per-target override; defaults to AIR_WEB__VERIFY_TLS below.
#AIR_WEB__TARGETS__LOCAL__VERIFY_TLS=true

# ── Remote targets ─────────────────────────────────────────────────────
# Uncomment and fill in for each deployment you test against. The name
# between TARGETS__ and the field is yours to choose; it appears in the
# sidebar and in the target bar at the top of every screen. Anything not on
# this machine is flagged REMOTE in amber throughout the UI.
#
# Keys here are real credentials in an untracked file. Do not commit
# `.env.local`.

#AIR_WEB__TARGETS__QA__LABEL=QA
#AIR_WEB__TARGETS__QA__CLASSIFIER_BASE_URL=https://classifier.qa.example.internal
#AIR_WEB__TARGETS__QA__CLASSIFIER_API_KEY=
#AIR_WEB__TARGETS__QA__ORCHESTRATOR_BASE_URL=https://orchestrator.qa.example.internal
#AIR_WEB__TARGETS__QA__ORCHESTRATOR_CUSTOMER_API_KEY=
#AIR_WEB__TARGETS__QA__ORCHESTRATOR_BUSINESS_API_KEY=
#AIR_WEB__TARGETS__QA__LLM_BASE_URL=https://llm.qa.example.internal
#AIR_WEB__TARGETS__QA__LLM_API_KEY=
# Self-signed staging endpoint? Override per-target rather than globally.
#AIR_WEB__TARGETS__QA__VERIFY_TLS=false

# ── Server behaviour ───────────────────────────────────────────────────

# Seconds before the console gives up on a request. Generous by default: a
# cold local model, or a remote environment scaled to zero, can take a
# while. A client can request less; the server clamps any request to
# [1, 120]s regardless — this is no longer a client-trusted value.
AIR_WEB__TIMEOUT_SECONDS=60
# Verify TLS certificates — the deployment-wide default when a target
# doesn't declare its own VERIFY_TLS above. Server-only: there is no
# sidebar toggle for this anymore (a client-controlled TLS bypass was an
# MITM-adjacent footgun).
AIR_WEB__VERIFY_TLS=true

# Appearance at start-up: auto | light | dark. `auto` follows the browser's
# prefers-color-scheme. The sidebar can override it per session — once it
# has, this value is no longer consulted.
AIR_WEB__THEME=auto

# Every AIR service bills and reports cost in USD; this only sets the ₹
# figure shown alongside it for convenience. Not a live rate — adjust it in
# the sidebar's Request behaviour panel per session, or preset it here.
AIR_WEB__USD_TO_INR_RATE=87.0
