# ── AIR full local integration (added by air-web-console: make platform-env) ──
#
# air-orchestrator-service's .env.example ships with every optional service switched
# off, so a fresh checkout answers from the model alone. This block switches on the
# classifier, document search, order lookups and confirmed changes against the sibling
# services' development builds. It is appended to the END of the orchestrator's .env:
# when a key appears twice in a .env file, the last value wins.
#
# Development values only. Every key below is a published development key that works
# only against the development salts in the sibling repos' .env.example files.
# Remove this whole block to go back to the defaults.

# Answers and planning use the gateway's `cloud` class, which needs at least one cloud
# provider key in air-model-gateway's .env (Gemini is first in the chain). With no
# cloud key, set MODEL_CLASS=local: chat still answers, but lookups and changes are
# not planned.
AIR_ORCHESTRATOR_SERVICE__MODEL_GATEWAY__MODEL_CLASS=cloud
AIR_ORCHESTRATOR_SERVICE__PLANNER__ENABLED=true
AIR_ORCHESTRATOR_SERVICE__PLANNER__MODEL_CLASS=cloud

# air-classifier-service :8082
AIR_ORCHESTRATOR_SERVICE__DOWNSTREAM__CLASSIFIER__ENABLED=true
AIR_ORCHESTRATOR_SERVICE__DOWNSTREAM__CLASSIFIER__API_KEY=airc_local_dev_key

# air-rag-service :8087
AIR_ORCHESTRATOR_SERVICE__DOWNSTREAM__RAG__ENABLED=true
AIR_ORCHESTRATOR_SERVICE__DOWNSTREAM__RAG__API_KEY=airr_local_dev_key

# air-tools-gateway :8084 — one read key and one execute key per tenant
AIR_ORCHESTRATOR_SERVICE__DOWNSTREAM__TOOLS_GATEWAY__ENABLED=true
AIR_ORCHESTRATOR_SERVICE__DOWNSTREAM__TOOLS_GATEWAY__TENANT_KEYS={"brightcart":{"read":"airtg_read_local_dev","execute":"airtg_exec_local_dev"}}
AIR_ORCHESTRATOR_SERVICE__DOWNSTREAM__TOOLS_GATEWAY__ALLOW__CUSTOMER=["orders.*"]

# The shop the assistant speaks for (the development corpus is Brightcart's).
AIR_ORCHESTRATOR_SERVICE__PROMPTS__PERSONA__BRAND_NAME=Brightcart

# The same two development keys as .env.example, with allow_actions switched on for the
# customer key so a confirmed change (cancel an order) can be proposed and executed.
AIR_ORCHESTRATOR_SERVICE__SECURITY__API_KEYS_INLINE=[{"id":"local-customer","name":"Local customer key","key_hash":"83f6efb5dfd5e989ec57ab8524d293ef7128153f0ad003b5f29238c75a583ad6","channel":"customer","tenant":"brightcart","scopes":["chat:write","session:read","admin:read"],"allow_actions":true},{"id":"local-business","name":"Local business key","key_hash":"139ff75bcc1ad38b240d27f83dc294e62c69cc8752cdff740012241a16dfc378","channel":"business","tenant":"brightcart","scopes":["query:write","session:read","admin:read"],"allow_actions":false}]
# ── end AIR full local integration ──
